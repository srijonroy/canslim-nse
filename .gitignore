# secrets / credentials -- never commit
.env
.fyers_token.json
.browser_profile/
fyersApi.log
fyersRequests.log

# copyrighted book (keep a local copy only)
How to Make Money in Stocks*.pdf

# rebuildable caches: several files exceed GitHub's 100 MB per-file limit
__pycache__/
data/cache/
data/prices/*.bf

# price files (~150 MB, all rewritten by every scan) ship as a zip on the GitHub release "data-latest"
# instead -- see canslim/datapack.py. data/prices_version.txt (tracked) says which zip the app expects.
data/prices/

# logs
*.log

# blind-test chart images are rebuilt by `python -m canslim.blindtest make`
data/tune/blindtest/*/charts/

# strict-book test working files (rebuilt by `python -m canslim.exp run strict-book`)
data/tune/strict-book/*.pkl
data/tune/strict-book/breakout_mask*.parquet

# third-party investor deck - local copy only
PPT (2).pdf
